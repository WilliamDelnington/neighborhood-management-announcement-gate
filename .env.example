# Dia chi API backend (bat buoc). Anh tai len (/uploads/...) duoc lay tu cung
# host nay, sau khi bo hau to /api.
VITE_API_BASE_URL=http://localhost:4000/api

# Ma phuong/xa (tuy chon). Khi dat, chi hien Tổ dân phố
# cua phuong nay (truyen ?wardCode= cho /neighborhoods/public).
# Bo trong = lay tat ca.
VITE_WARD_CODE=

# Dia chi ung dung cu dan (resident-web-app, tuy chon), vd https://app.example.vn.
# Dung cho nut "Đăng nhập cư dân" (-> /login cua app do) va cac lien ket sau:
# khao sat (/surveys/:id), gui phan anh
# (/complaints/create) - app cu dan tu yeu cau dang nhap roi quay lai dung
# trang. Bo trong = an nut tren header, the dang nhap hien chua kha dung.
VITE_RESIDENT_APP_URL=

# Authorized-user admin app base URL. The sign-in card opens /login.
# Leave blank to show the card as unavailable until configured.
VITE_ADMIN_APP_URL=

# Optional MapLibre style URL. Blank uses OpenFreeMap with an OSM raster fallback.
VITE_MAP_STYLE_URL=
