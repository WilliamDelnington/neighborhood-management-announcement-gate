# Dia chi API backend (bat buoc). Anh tai len (/uploads/...) duoc lay tu cung
# host nay, sau khi bo hau to /api.
VITE_API_BASE_URL=http://localhost:4000/api

# Ma phuong/xa (tuy chon). Khi dat, chi hien dich vu hen lich va Tổ dân phố
# cua phuong nay (truyen thanh ?wardCode= cho /appointment-services/public va
# /neighborhoods/public). Bo trong = lay tat ca.
VITE_WARD_CODE=

# Dia chi ung dung cu dan (tuy chon), dung cho nut "Tham gia trên ứng dụng cư
# dân" (khao sat), "Đặt lịch trên ứng dụng cư dân" va "Gửi phản ánh". Bo trong
# = chi hien chu, khong co lien ket.
VITE_RESIDENT_APP_URL=
